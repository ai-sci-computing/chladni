# --- Build directories
build/
build-*/
out/
cmake-build-*/

# --- CMake artefacts (in case CMake is run from the source tree by mistake)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile
_deps/
compile_commands.json

# Note: compiled artefact patterns (*.o, *.obj, *.a, *.so, *.dylib) are
# intentionally NOT listed here. They only ever live inside build/, which
# is already ignored above. A blanket "*.obj" rule would also match the
# Wavefront .obj mesh files in models/ and data/.

# --- Generated documentation (regenerated by `cmake --build build --target docs`)
docs/html/
docs/latex/
docs/xml/
docs/man/

# --- Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*.user
*.user.*
.cache/
.ccls-cache/

# --- macOS
.DS_Store
.AppleDouble
.LSOverride

# --- Audio outputs (regeneratable; track only test fixtures explicitly)
/*.wav
out_*.wav

# --- GUI runtime state (Polyscope and Dear ImGui write these on exit)
.polyscope.ini
imgui.ini

# --- Python (in case a pybind11 wrapper is added later)
__pycache__/
*.pyc
.venv/
.claude/
